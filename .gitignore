# Scratch output dir used when the sandbox delete-guard blocks `vite build` from
# emptying `dist/` (see FE-14/FE-15 phase notes). Each verification run needs a
# fresh directory, because the guard counts the files it would have to delete.
.build-check/
.build-check-*/
# Scratch previews from the icon-generation run; only `frontend/public/*` and
# `frontend/scripts/generate_icons.py` are meant to be committed.
.iconwork/

